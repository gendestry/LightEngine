@startuml CommandsArchitecture
title LightEngine Commands — parse pipeline & interpreter layer

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' =========================================================================
'  GENERATED LAYER  (gen_ast.py  <-  commands.spec)  — pure data, no logic
' =========================================================================
package "Generated (commands_ast.h)" #E8F0FE {

  interface CommandVisitor {
    +visit(SelectCmd&)
    +visit(StoreCmd&)
    +visit(DeleteCmd&)
    +visit(ClearCmd&)
    +visit(AtCmd&)
  }

  abstract class Command {
    +accept(CommandVisitor&)
  }
  abstract class Selector {
    +accept(SelectorVisitor&)
  }

  class SelectCmd
  class StoreCmd
  class DeleteCmd
  class ClearCmd
  class AtCmd

  class Fixture
  class FixtureRange
  class Group
  class Preset

  Command <|-- SelectCmd
  Command <|-- StoreCmd
  Command <|-- DeleteCmd
  Command <|-- ClearCmd
  Command <|-- AtCmd

  Selector <|-- Fixture
  Selector <|-- FixtureRange
  Selector <|-- Group
  Selector <|-- Preset
}

' =========================================================================
'  PROGRAMMER LAYER  — meaning: state + how commands mutate it (hand-written)
' =========================================================================
package "Programmer layer (hand-written)" #FEF7E0 {

  class Builder <<free fn>> {
    +buildProgram(CST&) : Program
  }

  class Context {
    +MAX_FIXTURES : int
    --
    +selected : set<int>
    +groups   : map<int, set<int>>          ' SNAPSHOT: flattened fids
    +presets  : map<pair<int,int>, set<int>>
    +level    : array<float>
    --
    +hasSelection() : bool
  }
  note right of Context
    Design choice: **snapshot groups**.
    store resolves a selection down to
    raw fixture ids, so groups are frozen
    unions (re-store to update).
    Console-standard; no cycles; O(1) lookup.
  end note

  class Resolver {
    -ctx : Context&
    +resolve(Selector&) : set<int>
    +visit(Fixture&)
    +visit(FixtureRange&)
    +visit(Group&)     ' -> ctx.groups[id]
    +visit(Preset&)    ' -> ctx.presets[key]
  }

  class Interpreter {
    +ctx : Context
    +run(Program&)
    +visit(SelectCmd&)
    +visit(StoreCmd&)
    +visit(DeleteCmd&)
    +visit(ClearCmd&)
    +visit(AtCmd&)
    -foldSelection(items) : set<int>
    -applyAt(AtValue&)
  }
}

CommandVisitor <|.. Interpreter
Interpreter *-- Context
Interpreter ..> Resolver : uses per selection
Resolver o-- Context : reads groups/presets
Interpreter ..> Command : accept()
Resolver ..> Selector : accept()
Builder ..> Command : constructs

' =========================================================================
'  PIPELINE
' =========================================================================
package "Pipeline (main.cpp)" #E6F4EA {
  note as N1
    text -> [Lexer] tokens
         -> [Engine + grammar] CST
         -> [Builder] AST (Program)
         -> [Interpreter/visitor] mutates Context
  end note
}

@enduml
