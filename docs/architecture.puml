@startuml LightEngine
' Class diagram of the current (remake2) LightEngine code under include/ + src/.
' The old/ tree is intentionally excluded.

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "LightEngine::GDTF" {
    enum Attribute {
        DIMMER
        COLOR_R
        COLOR_G
        COLOR_B
        COLOR_W
        ...
    }

    struct DMXRange {
        + min : uint32_t
        + max : uint32_t
    }

    struct PhysicalRange {
        + min : float
        + max : float
    }

    struct ChannelFunction {
        + dmx : DMXRange
        + physical : PhysicalRange
    }

    struct DMXChannel {
        + enum Resolution
        + offsets
    }

    struct LogicalChannel {
        + attribute : Attribute
        + channel : DMXChannel
        + functions : vector<ChannelFunction>
    }

    LogicalChannel *-- DMXChannel
    LogicalChannel *-- "0..*" ChannelFunction
    LogicalChannel --> Attribute
    ChannelFunction *-- DMXRange
    ChannelFunction *-- PhysicalRange
}

package "LightEngine::Fixtures" {
    class Parameter {
        - m_def : shared_ptr<const LogicalChannel>
        + SetDefinition(def)
        + Definition() : const shared_ptr<const LogicalChannel>&
    }

    class ColorCell {
        - m_r/m_g/m_b/m_w : Parameter*
        - m_dimmer : Parameter*   ' nullptr => virtual dimmer
        - m_hsv : HSV
        + SetComponent(attr, p)
        + SetColor(hsv)
        + SetHueSat(h, s)
        + SetIntensity(v)
        + Resolve()
    }

    class Fixture {
        - m_name : string
        - m_fid : uint16_t
        - m_buffer : uint8_t*   ' non-owning, into the universe
        - m_parameters : vector<Parameter>
        - m_byAttribute : map<Attribute, vector<Parameter*>>
        - m_colorCells : vector<ColorCell>
        + Add(def, cellIndex) : Parameter&
        + Build()
        + Bind(buffer, start)
        + Has(attr) : bool
        + Cell(index) : ColorCell&
        + Resolve(values : FixtureValues)
    }

    Fixture *-- "0..*" Parameter
    Fixture *-- "0..*" ColorCell
    ColorCell o-- "0..5" Parameter : non-owning >
    Parameter --> LogicalChannel : shared def >
}

package "LightEngine::DMX" {
    class Universe {
        - m_id : uint16_t
        - m_byName : map<string, vector<FixturePtr>>
        + addFixture(fixture[, start]) : FixturePtr
        + addFixtures(fixture, count, start)
        + at(index) / byName(name)
        + buffer() : 512-byte DMX frame
        - wireBuffers()
        - reindex()
    }
    note right of Universe
      Owns the fixtures (shared_ptr) and the
      512-byte DMX buffer they write into.
    end note

    class FixtureGroup {
        - m_name : string
        - m_fixtures : vector<FixturePtr>
        - m_usedUniverses : set<uint16_t>
        - m_byAttribute : map<Attribute, vector<Parameter*>>  {cache}
        - m_colorCells : vector<ColorCell*>  {cache}
        - m_fids : vector<uint16_t>  {cache}
        - m_revision : uint64_t
        + add(fixtures)
        + fixtures() / fids() / colorCells()
        + revision() : uint64_t
        + operator+=()
        - rebuildCache()
    }
    note bottom of FixtureGroup
      Non-owning named selection.
      m_revision bumps on every membership
      change so caches invalidate in O(1).
    end note

    "Utils::FragmentedStorage<Fixture,512>" <|-- Universe
    Universe o-- "0..*" Fixture : owns >
    FixtureGroup o-- "0..*" Fixture : refs >
}

package "LightEngine::Engine" <<Frame/Layers>> {
    enum MergePolicy {
        HTP
        LTP
    }

    struct FixtureValues {
        + color : optional<HSV>
        + intensity : optional<float>
        + generic : map<Attribute, float>
    }

    class Frame {
        - m_values : map<uint16_t, FixtureValues>
        + contribute(fid, in, policy)
        + get(fid) / all()
        + clear()
    }

    struct TimeContext {
        + now : double
        + dt : float
    }

    abstract class Layer {
        + enum Priority {ABOVE_PROG, PROG, HIGH, NORMAL, LOW}
        - m_priority : Priority
        + priority() : uint16_t
        + {abstract} apply(frame, time)
    }

    Frame *-- "0..*" FixtureValues
    Frame --> MergePolicy
    Layer ..> Frame
    Layer ..> TimeContext
}

package "LightEngine::Effects" {
    enum EffectType {
        STATIC
        ANIMATED
    }
    enum EffectCategory {
        DIMMER
        COLOR
    }

    abstract class EffectBase {
        - m_cache : vector<pair<fid, FixtureValues>>
        - m_policy : MergePolicy
        - m_dirty : bool
        - m_cachedRevision : uint64_t
        - m_nextDue / m_phaseOrigin : double
        + {abstract} recompute(t, group)
        + due(now, group) : bool
        + evaluate(t, group)
        + replay(frame)
        + markDirty() / syncPhase(now)
        + {abstract} GetEffectType() / GetEffectCategory()
    }

    abstract class EffectAnimated {
        - m_curve : unique_ptr<Curve>
        - m_bpm / m_spread : float
        - m_steps : uint16_t
        + stepInterval() : double
    }

    abstract class EffectStatic {
        + setValues(vals)
    }

    class DimmerChase
    class StaticColor
    class StaticIntensity

    struct EffectWrapper {
        + group : FixtureGroup
        + effect : shared_ptr<EffectBase>
    }

    class EffectGroup {
        - applied : vector<shared_ptr<EffectWrapper>>
        + push(eff) / pushRet(group, effect)
        + getEffects() / lastEffect()
        + operator[](index)
        + clear()
    }

    class Engine as "Effects::Engine" {
        - m_effects : vector<shared_ptr<EffectGroup>>
    }

    EffectBase <|-- EffectAnimated
    EffectBase <|-- EffectStatic
    EffectAnimated <|-- DimmerChase
    EffectStatic <|-- StaticColor
    EffectStatic <|-- StaticIntensity
    EffectBase --> EffectType
    EffectBase --> EffectCategory
    EffectBase ..> FixtureGroup : recompute over >
    EffectBase ..> Frame : replay into >

    EffectWrapper *-- FixtureGroup
    EffectWrapper o-- EffectBase
    EffectGroup *-- "0..*" EffectWrapper
    Layer <|-- EffectGroup
    "Effects::Engine" *-- "0..*" EffectGroup
}

package "LightEngine::Engine" <<Pools>> {
    class PoolObject {
        - m_number : uint32_t
        - m_name : string
        + number() / name() / setName()
        + describe() : string
    }

    class "Pool<T>" as PoolT {
        - m_items : map<uint32_t, shared_ptr<T>>
        + items()
        + clear()
    }

    class "Pools::Group" as PGroup {
        - m_fg : FixtureGroup
        + add(fx)
        + fids() : vector<uint16_t>
    }

    class "Pools::Color" as PColor {
        - m_effect : shared_ptr<StaticColor>
    }

    class Presets {
        - m_groups : Pool<Pools::Group>
        - m_colors : Pool<Pools::Color>
        + groups() / colors()
        + clear() / describe()
    }

    PoolObject <|-- PGroup
    PoolObject <|-- PColor
    PoolT o-- "0..*" PoolObject
    Presets *-- "2" PoolT
    PGroup *-- FixtureGroup
    PColor o-- StaticColor
}

package "LightEngine::Engine" <<Core>> {
    struct Config

    struct Vendor {
        + fixtures : map<string, Fixture>
    }

    class FixtureLibrary {
        - vendor : Vendor
        + add(...)
        - addDefaults()
    }

    class FixtureBuilder {
        + MakeChannel8Bit(attr, ...) : shared_ptr<const LogicalChannel>
        + Get() : Fixture
    }

    class Patch {
        - m_universes : map<uint16_t, Universe>
        - m_fixtures : map<uint16_t, FixturePtr>   ' by FID
        - m_byName : map<string, vector<FixturePtr>>
        + patch(fixture, universe, amount, ...) : vector<uint16_t>
        + universes() / fixtures()
        + getFixtures(fids) : vector<FixturePtr>
    }

    class GroupSelection {
        - m_selected : FixtureGroup
        + select(g) / add(g) / get()
    }

    class StaticEffectHolder {
        - values : map<uint16_t, FixtureValues>
        - byType : map<EffectCategory, set<uint16_t>>
        - selection : GroupSelection&
        + get(cat, group)
        + getValues()
        + clear()
    }

    struct All {
        + values : map<uint16_t, FixtureValues>
    }

    class Programmer {
        - m_patch : Patch&
        - m_runningEffects : EffectGroup
        - m_selection : GroupSelection
        - m_staticEffects : StaticEffectHolder
        + select(g | fids) / add(g | fids)
        + applyEffect(eff)
        + setColor(rgb) / setIntensity(v)
        + selected() : const FixtureGroup&
        + clearAll()
        - ensureColor(fid) / singleFixture(fid)
    }

    class Engine as "Engine::Engine" {
        - m_config : Config
        - m_patch : Patch
        - m_time : TimeContext
        - m_library : FixtureLibrary
        - m_output : DMXOutput
        - m_effectEngine : Effects::Engine
        - m_frame : Frame
        - m_programmer : Programmer
        - m_layers : vector<Layer*>   ' composed low -> high
        - m_presets : Presets
        + patch(fixture, universe, amount, ...)
        + selectGroup(num)
        + storeGroup([num]) : Pools::Group&
        + storeColorPreset(num) / recallColorPreset(num)
        + update(dt)
    }

    FixtureLibrary *-- Vendor
    FixtureBuilder ..> Fixture : builds >
    FixtureLibrary ..> FixtureBuilder
    Patch *-- "0..*" Universe
    Programmer --> Patch : uses >
    Programmer *-- GroupSelection
    Programmer *-- StaticEffectHolder
    Programmer *-- EffectGroup : running >
    StaticEffectHolder --> GroupSelection

    "Engine::Engine" *-- Config
    "Engine::Engine" *-- Patch
    "Engine::Engine" *-- TimeContext
    "Engine::Engine" *-- FixtureLibrary
    "Engine::Engine" *-- Frame
    "Engine::Engine" *-- Programmer
    "Engine::Engine" *-- Presets
    "Engine::Engine" *-- "Effects::Engine"
    "Engine::Engine" o-- "0..*" Layer : composes low->high >
}

package "LightEngine::Output" {
    class DMXOutput {
        - m_ip : IP
        - m_sourceName : string = "Mixer"
        - m_senders : map<uint16_t, SacnSender>
        + setIP(ip) / setSourceName(name)
        + send(universe)
        + update(dirty, patch)
        + sendAll(patch)
        - ensureSender(universe)
    }
    note bottom of DMXOutput
      sACN only for now; a protocol
      interface can replace SacnSender later.
    end note

    DMXOutput ..> Universe : sends >
    DMXOutput ..> Patch
}

"Engine::Engine" *-- DMXOutput

' ---- per-frame data flow ----
note as N1
  <b>update(dt) pipeline</b> (non-tracking)
  1. advance TimeContext
  2. Frame.clear()
  3. each Layer (low -> high) apply() -> Frame.contribute(policy)
     effects: due() ? evaluate() : replay()
  4. Fixture.Resolve(FixtureValues) -> ColorCell.Resolve() -> DMX bytes
  5. DMXOutput.update(dirty, patch) -> sACN
end note

@enduml
