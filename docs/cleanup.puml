    {abstract} recompute(t, group)
    due() / evaluate() / replay()
    markDirty() / syncPhase()
    stepInterval() / scheduleNext()
    setEnabled()
  }

  abstract class EffectStatic <<done>> {
    setCache(vals)
    stepInterval() = NEVER
  }

  abstract class EffectAnimated <<done>> {
    m_curve / m_bpm
    m_spread / m_steps
    --
    setBpm(bpm, now)
    setSpread() / setSteps()
    stepInterval()
