' =============================================================================
' Engine layers / frame
' =============================================================================
package "LightEngine::Engine (frame)" #FFF0F8 {

  enum MergePolicy <<live>> {
    HTP
    LTP
  }

  struct FixtureValues <<live>> {
    color : optional<HSV>
    intensity : optional<float>
    generic : map<Attribute, float>
  }

  class Frame <<live>> {
    - m_values : map<fid, FixtureValues>
    --
    contribute(fid, values, policy)
    get(fid) / all() / clear()
    --
    ONE shared frame for everything;
    the policy comes from the effect
  }

  abstract class Layer <<inert>> {
    Priority : ABOVE_PROG | PROG | HIGH | NORMAL | LOW
    - m_priority : Priority
    --
    priority() / enabled()
    {abstract} apply(Frame&, TimeContext)
    --
    EffectGroup is the only subclass;
    Engine::m_layers is never filled
  }

  class StaticEffectHolder <<inert>> {
    values : map<fid, FixtureValues>
    onGroups : Interval
    byType : map<EffectCategory, set<fid>>
    --
    setColor() / setIntensity()
    getColor() / getIntensity()
    --
    the pre-effect way of holding
    programmer state; commented out
    of Programmer, still compiled
  }

  Frame *-- FixtureValues
  Frame ..> MergePolicy
  FixtureValues ..> Attribute
}

' =============================================================================
' Effects
' =============================================================================
package "LightEngine::Effects" #FFFDF0 {

  enum EffectType <<live>> {
    STATIC
    ANIMATED
  }

  enum EffectCategory <<live>> {
    DIMMER
    COLOR
  }

  abstract class EffectBase <<live>> {
    # m_cache : vector<pair<fid, FixtureValues>>
    # m_policy : MergePolicy
    # m_dirty : bool
    # m_cachedRevision : uint64_t   (dead)
    # m_nextDue / m_phaseOrigin : double
    --
    {abstract} recompute(TimeContext, Interval)
    emit(fid, values)
    stepInterval() : double  (NEVER by default)
    due(now, group) : m_dirty || now >= m_nextDue
    evaluate() -> clear + recompute + scheduleNext
    replay(Frame&) -> contribute cached pairs
    markDirty() / syncPhase() / setEnabled()
  }

  abstract class EffectStatic <<live>> {
    setCache(vals)
    stepInterval() = NEVER
  }

  abstract class EffectAnimated <<live>> {
    # m_curve : unique_ptr<Curve>
    # m_bpm / m_spread : float
    # m_steps : uint16_t
    --
    setBpm(bpm, now) -> syncPhase
    setSpread() / setSteps()
    stepInterval() = (60/bpm)/steps
  }

  class StaticColor <<live>> {
    - m_color : RGB
    setColor(RGB)
    recompute() -> HSV, LTP
  }

  class StaticIntensity <<live>> {
    - m_level : float
    setLevel(float)
    recompute() -> LTP
  }

  class DimmerChase <<live>> {
    - m_type : Utils::Maths::Type
    setCurve(type)
    recompute() -> temporal phase
    (bpm) x spatial phase (spread)
    policy = HTP
  }

  struct EffectWrapper <<live>> {
    group : Interval
    effect : shared_ptr<EffectBase>
    --
    no id: nothing can address a
    running effect afterwards
  }

  class EffectGroup <<live>> {
    - applied : vector<shared_ptr<EffectWrapper>>
    --
    push<T>(group, args...)
    pushRet<T>(group, args...) -> handle
    lastEffect() / operator[] / getEffects()
    apply(Frame&, TimeContext) : override
    --
    IS a Layer, but is driven as a
    plain container by Programmer
  }

  class "Effects::Engine" as FxEngine <<inert>> {
    - m_effects : vector<shared_ptr<EffectGroup>>
    --
    empty shell, no members declared
  }

  EffectBase <|-- EffectStatic
  EffectBase <|-- EffectAnimated
  EffectStatic <|-- StaticColor
  EffectStatic <|-- StaticIntensity
  EffectAnimated <|-- DimmerChase
  EffectBase --> EffectType
  EffectBase --> EffectCategory
  EffectWrapper *-- EffectBase
  EffectGroup *-- EffectWrapper
  Layer <|-- EffectGroup
  FxEngine o-- EffectGroup
  EffectBase ..> Frame : replay()
  EffectBase *-- FixtureValues
}

