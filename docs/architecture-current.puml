' =============================================================================
' GDTF - immutable channel definitions (flyweights, shared by shared_ptr)
' =============================================================================
package "LightEngine::GDTF" #F4F9FF {

  enum Attribute <<live>> {
    DIMMER
    VDIMMER
    COLOR_R / COLOR_G / COLOR_B / COLOR_W
    --
    six values only - no PAN/TILT/
    GOBO/ZOOM anywhere in the tree
  }

  struct DMXChannel <<live>> {
    address : uint16_t
    res : Resolution (Bit8 | Bit16)
    MaxDMX() : uint16_t
  }

  struct DMXRange <<live>> {
    from / to : uint32_t
    Contains() / Normalize()
  }

  struct PhysicalRange <<live>> {
    min / max : float
    Normalize() / FromNormalized()
  }

  struct ChannelFunction <<live>> {
    name : string
    range_dmx : DMXRange
    range_physical : PhysicalRange
    Evaluate(dmx) : float
  }

  struct LogicalChannel <<live>> {
    attribute : Attribute
    channel : DMXChannel
    functions : vector<ChannelFunction>
  }

  LogicalChannel *-- DMXChannel
  LogicalChannel --> Attribute
  LogicalChannel *-- ChannelFunction
  ChannelFunction *-- DMXRange
  ChannelFunction *-- PhysicalRange
}

' =============================================================================
' Fixture - the runtime model. Owns no bytes; points into a universe buffer.
' =============================================================================
package "LightEngine::Fixtures" #F7F4FF {

  struct FixtureTemplate <<live>> {
    name : string
    parameters : vector<ParameterConfig>
  }

  struct ParameterConfig <<live>> {
    definition : shared_ptr<const LogicalChannel>
    cellIndex : uint16_t
  }

  class Parameter <<live>> {
    - m_def : shared_ptr<const LogicalChannel>
    - m_bytes : uint8_t*        (non-owning)
    - m_baseOffset : uint32_t
    - m_cellIndex : uint16_t
    --
    Write(float 0..1)
    WriteRaw(channel, dmx)
    Bound() / Unbind()
  }

  class ColorCell <<live>> {
    - m_r / m_g / m_b / m_w : Parameter*
    - m_dimmer : Parameter*   (null => virtual dimmer)
    - m_hsv : HSV
    --
    SetHueSat() / SetIntensity()
    Resolve()  : HSV -> RGB (+ white)
  }

  class Fixture <<live>> {
    - m_config : shared_ptr<FixtureTemplate>
    - m_fid : uint16_t
    - m_buffer : uint8_t*      (non-owning)
    - m_parameters : vector<Parameter>
    - m_byAttribute : map<Attribute, vector<Parameter*>>
    - m_colorCells : vector<ColorCell>
    --
    Add(def, cell) / Build()
    setStart() / setBuffer() / Bind()
    **Resolve(FixtureValues)**  <- the frame sink
    Fid() / SetFid()
    --
    still derives Utils::Fragment
    (start/size) although universes
    no longer use FragmentedStorage
  }

  FixtureTemplate *-- ParameterConfig
  ParameterConfig --> LogicalChannel
  Fixture *-- Parameter
  Fixture *-- ColorCell
  Fixture --> FixtureTemplate
  ColorCell o-- Parameter
  Parameter --> LogicalChannel
}

package "LightEngine::FixtureTools" #F7F4FF {

  class ParameterCell <<setup>> {
    - m_offset / m_cellIndex : uint16_t
    - parameters : vector<ParameterConfig>
    --
    add8Bit(Attribute)
    operator<<(Attribute)
    setCellIndex() / get()
  }

  class FixtureBuilder <<inert>> {
    ftemplate / cellIndex / relOffset
    parCell : ParameterCell
    --
    create(name) / newCell()
    addColorRed()  <- empty body
    nothing constructs one
  }

  ParameterCell ..> ParameterConfig
  FixtureBuilder *-- ParameterCell
}

' =============================================================================
' DMX - universes and their byte buffers
' =============================================================================
package "LightEngine::DMX" #FFF9F0 {

  class PatchInfo <<live>> {
    start / size / id : uint32_t
    --
    copy ctor copies start+size
    but **not** id (see D6)
  }

  class UniversePatch <<live>> {
    - m_id : uint16_t
    - m_buffer : array<uint8_t, 512>
    - m_bytesPatched : array<uint16_t, 512>
    - m_fragments : list<PatchInfo>
    - m_fragIDCounter : uint16_t
    --
    add(size, start) / add(size)
    addMultiple(size, start, n)
    checkMultiple() / findFirstEmpty()
    remove(fragID) / getInfo(id)
    getRaw() / buffer() / clearBuffer()
    fragmentsToString() / dump()
  }

  class FixtureGroup <<inert>> {
    m_fixtures : vector<FixturePtr>
    m_byAttribute / m_colorCells / m_fids
    m_revision : uint64_t
    --
    the only type with revision()
    superseded by Utils Interval;
    still #included by EffectBase,
    Layer, Pools::Group - never built
  }

  UniversePatch *-- PatchInfo
}

' =============================================================================
' Engine::Components
' =============================================================================
package "LightEngine::Engine::Components" #F0FFF4 {

  class FixtureLibrary <<setup>> {
    - vendor.fixtures : map<string, Fixture>
    --
    find(name) : Fixture*
    addDefaults()  <- one hardcoded
    3-channel "RGB", built in the ctor
  }

  class Patch <<live>> {
    - m_fixCurrentID : uint64_t
    - m_fixtureByUID : map<uid, FixturePtr>
    - m_fixtureStatus : map<uid, FixtureStatus>
    - m_fixtureByFIDs : map<fid, vector<uid>>
    - m_universes : map<uni, UniversePatch>
    --
    addFixtures(fixture, amount)
    patch(uid, uni, addr)
    patch(vector<uid>, uni, addr)
    patch(Fixture*, uni, amount, start, startFID)
    unpatch(uid) / unpatch(vector) / removeFixture()
    **fixturesByFID(fid)**  <- used by update()
    getFixture(uid) / sortedByAddress()
    clearDMXBuffers() / universes()
  }

  struct FixtureStatus <<live>> {
    universe : uint16_t
    patchInfoID : uint32_t
  }

  struct FixPatch <<live>> {
    universe : uint16_t
    info : PatchInfo
  }

  class Programmer <<live>> {
    - m_runningEffects : Effects::EffectGroup
    - m_interval : Utils::Maths::Interval
    --
    select(Interval) / select(vector<fid>)
    add(Interval) / add(vector<fid>)
    setColor(RGB) / setIntensity(float)
    addDimmerChase()
    **apply(Frame&, TimeContext)**
    clearAll() / selected()
    --
    NOT a Layer (only Stringify)
    applyEffect() declared, never defined
    toString() is an empty stub
  }

  class FixtureSelection <<inert>> {
    m_interval : Interval
    select() / add() / clear() / get()
    --
    byte-for-byte duplicate of the
    selection code inside Programmer;
    the member is commented out there
  }

  class Presets <<setup>> {
    - m_groups : Pool<Pools::Group>
    - m_colors : Pool<Pools::Color>
    --
    groups() / colors() / clear()
    dimmer, sequence, effect pools
    are commented out
  }

  Patch *-- UniversePatch
  Patch *-- FixtureStatus
  Patch ..> FixPatch
  Patch o-- Fixture
  FixtureLibrary o-- Fixture
