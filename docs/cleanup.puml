@startuml LightEngineCleanup
' Snapshot of the code as it stands on the `cleanup` branch, plus the pieces
' that still have to be built.
'   GREEN  = exists and works
'   YELLOW = exists but incomplete / stubbed / partly commented out
'   RED    = does not exist yet
'   BLUE   = existing class that needs a specific change (noted in the class)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 45
hide empty members

skinparam class {
  BackgroundColor<<done>>    #B6E7B0
  BorderColor<<done>>        #2E7D32
  BackgroundColor<<partial>> #FFE7A3
  BorderColor<<partial>>     #F9A825
  BackgroundColor<<todo>>    #F2B8B8
  BorderColor<<todo>>        #C62828
  BackgroundColor<<change>>  #BBDEFB
  BorderColor<<change>>      #1565C0
}

legend top left
  <back:#B6E7B0>  implemented  </back>  <back:#FFE7A3>  partial / stubbed  </back>  <back:#F2B8B8>  to be added  </back>  <back:#BBDEFB>  needs change  </back>
endlegend

